# Copy this file to .env and configure the services you use.
# Never put credentials in frontend files or commit the populated .env file.
# Commerce transactions require a local persistent disk (shared by all workers).
# Defaults to PRIVATE_DATA_DIR/commerce.sqlite; keep the DB, -wal and -shm private.
# COMMERCE_DATABASE_FILE=/var/data/ocop/commerce.sqlite
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Configure the AI services you want to use. Missing keys are never simulated.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# ensemble: compare services by default; interactive chat/STT use the first valid result.
# fallback: try configured services in order within the shared deadline.
AI_PROVIDER_MODE=ensemble
# Text AI budget (clamped to 1.5–8 seconds). Image AI: up to 22s.
# Shared chat route ceiling: 26s; browser send/upload ceiling: 30s.
AI_CHAT_TIMEOUT_MS=8000

# Image recognition also accepts signed temporary guest-image sessions (no login).
# Other AI operations require real customer sessions. Browser roles grant no access.
# Global emergency stop applies to both users and guests (restart needed):
AI_ENABLED=true
# Proxy trust is OFF by default. Set to the verified ingress CIDRs/hop count only.
# Never set true or trust arbitrary X-Forwarded-For values.
TRUST_PROXY=
# Additional exact browser origins (comma-separated); no wildcards or null/file:.
AI_CORS_ORIGINS=
# Single-writer JSON deployment: mount this directory on persistent storage.
# PRIVATE_DATA_DIR=/var/data/ocop
# AI_ACCESS_FILE=/var/data/ocop/ai-access.json
# Separate KPI service credentials; configure the same random secret at both ends.
OCOP_KPI_SYNC_TOKEN=
# Optional private metrics service token: at least 32 random characters,
# distinct from customer/admin sessions, configured on both services.
OCOP_METRICS_TOKEN=

# Required for staff access to customer images and any saved audio. Use a unique random value of at least 24 characters.
AUDIO_ADMIN_PASSWORD=

# Optional Twilio SMS settings for customer registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google/Facebook OAuth login. Register the exact callback URLs with each provider.
AUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_API_VERSION=v24.0

# Wikipedia is used for public cultural background, not product prices or stock.

# Optional persistent KPI telemetry location (defaults to .private-data/ai-metrics.json).
# AI_METRICS_FILE=
# SALES_CONVERSATIONS_FILE=
# Separate KPI service: KPI_PORT=3002, OCOP_METRICS_URL=http://localhost:3000/api/ai/metrics
