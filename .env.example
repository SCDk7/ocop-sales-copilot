# Copy this file to .env and configure the services you use.
# Never put credentials in frontend files or commit the populated .env file.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Fast Gemini model for the shared five-second text-chat deadline.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# Required for staff access to customer images and any saved audio. Use a unique random value of at least 24 characters.
AUDIO_ADMIN_PASSWORD=

# Optional Twilio SMS settings for customer registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google/Facebook OAuth login. Register the exact callback URLs with each provider.
AUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_API_VERSION=v24.0

# Legacy OPENAI_API_KEY/OPENAI_MODEL settings are ignored by customer chat.

# Optional persistent KPI telemetry location (defaults to .private-data/ai-metrics.json).
# AI_METRICS_FILE=
# SALES_CONVERSATIONS_FILE=
# Separate KPI service: KPI_PORT=3002, OCOP_METRICS_URL=http://localhost:3000/api/ai/metrics
